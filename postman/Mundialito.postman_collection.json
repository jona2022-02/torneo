{
  "info": {
    "name": "Mundialito",
    "description": "Empieza por Auth / Entrar. Ese request guarda el token. Luego corre el listado de equipos para guardar teamId. Los POST envían Idempotency-Key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "teamId", "value": "" },
    { "key": "awayTeamId", "value": "" },
    { "key": "playerId", "value": "" },
    { "key": "matchId", "value": "" },
    { "key": "idempotencyKey", "value": "11111111-1111-1111-1111-111111111111" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Entrar",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('200', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.collectionVariables.set('token', body.token);"
              ]
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"TorneoDev_2026!\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Teams",
      "item": [
        {
          "name": "Listar",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('200', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.expect(body).to.include.keys('data', 'pageNumber', 'pageSize', 'totalRecords', 'totalPages');",
                "const real = body.data.find((team) => team.name === 'Real Madrid');",
                "const barca = body.data.find((team) => team.name === 'Barcelona');",
                "if (real) pm.collectionVariables.set('teamId', real.id);",
                "if (barca) pm.collectionVariables.set('awayTeamId', barca.id);"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/teams?pageNumber=1&pageSize=10&sortBy=name&sortDirection=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teams"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" },
                { "key": "sortBy", "value": "name" },
                { "key": "sortDirection", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Filtrar por nombre",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/teams?name=Madrid&pageNumber=1&pageSize=10"
          }
        },
        {
          "name": "Detalle",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/teams/{{teamId}}"
          }
        },
        {
          "name": "Crear",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('201', () => pm.response.to.have.status(201));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Sevilla\"\n}" },
            "url": "{{baseUrl}}/api/teams"
          }
        },
        {
          "name": "Reemplazar",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Sevilla FC\"\n}" },
            "url": "{{baseUrl}}/api/teams/{{teamId}}"
          }
        },
        {
          "name": "Actualizar parcial",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Sevilla\"\n}" },
            "url": "{{baseUrl}}/api/teams/{{teamId}}"
          }
        }
      ]
    },
    {
      "name": "Players",
      "item": [
        {
          "name": "Listar por equipo",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('200', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "if (body.data.length) pm.collectionVariables.set('playerId', body.data[0].id);"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/players?teamId={{teamId}}&pageNumber=1&pageSize=10&sortBy=shirtNumber&sortDirection=asc"
          }
        },
        {
          "name": "Detalle",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/players/{{playerId}}" }
        },
        {
          "name": "Crear",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Vinicius Jr\",\n  \"shirtNumber\": 7\n}" },
            "url": "{{baseUrl}}/api/teams/{{teamId}}/players"
          }
        }
      ]
    },
    {
      "name": "Matches",
      "item": [
        {
          "name": "Listar",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('200', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "if (body.data.length) pm.collectionVariables.set('matchId', body.data[0].id);"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/matches?pageNumber=1&pageSize=10&sortBy=kickoff&sortDirection=asc"
          }
        },
        {
          "name": "Filtrar finalizados",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/matches?status=Finalizado&teamId={{teamId}}&from=2026-10-01T00:00:00Z&to=2026-10-31T23:59:59Z&pageNumber=1&pageSize=10"
          }
        },
        {
          "name": "Detalle",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/matches/{{matchId}}" }
        },
        {
          "name": "Crear",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"homeTeamId\": \"{{teamId}}\",\n  \"awayTeamId\": \"{{awayTeamId}}\",\n  \"kickoff\": \"2026-10-25T15:00:00Z\"\n}"
            },
            "url": "{{baseUrl}}/api/matches"
          }
        },
        {
          "name": "Registrar resultado",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"homeScore\": 1,\n  \"awayScore\": 0,\n  \"goals\": [\n    { \"playerId\": \"{{playerId}}\", \"minute\": 12 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/matches/{{matchId}}/result"
          }
        }
      ]
    },
    {
      "name": "Standings",
      "item": [
        {
          "name": "Tabla",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('200', () => pm.response.to.have.status(200));",
                "pm.expect(pm.response.json()).to.have.property('data');"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/standings?pageNumber=1&pageSize=10"
          }
        }
      ]
    },
    {
      "name": "Scorers",
      "item": [
        {
          "name": "Goleadores",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/scorers?pageNumber=1&pageSize=10&sortBy=goals&sortDirection=desc"
          }
        },
        {
          "name": "Filtrar por equipo",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/scorers?teamId={{teamId}}&pageNumber=1&pageSize=10"
          }
        }
      ]
    },
    {
      "name": "Idempotencia",
      "item": [
        {
          "name": "Crear con clave fija",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('201', () => pm.response.to.have.status(201));"]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Idempotente FC\"\n}" },
            "url": "{{baseUrl}}/api/teams"
          }
        },
        {
          "name": "Repetir la misma clave y el mismo cuerpo",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('repite 201', () => pm.response.to.have.status(201));"]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Idempotente FC\"\n}" },
            "url": "{{baseUrl}}/api/teams"
          }
        },
        {
          "name": "Misma clave con otro cuerpo",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('409', () => pm.response.to.have.status(409));"]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Otro FC\"\n}" },
            "url": "{{baseUrl}}/api/teams"
          }
        }
      ]
    },
    {
      "name": "Errores",
      "item": [
        {
          "name": "Login inválido",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('401', () => pm.response.to.have.status(401));"]
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"incorrecta\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "sortBy inválido",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('400', () => pm.response.to.have.status(400));"]
            }
          }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/teams?sortBy=puntos" }
        },
        {
          "name": "Equipo inexistente",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('404', () => pm.response.to.have.status(404));"]
            }
          }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/teams/00000000-0000-0000-0000-000000000099" }
        },
        {
          "name": "Nombre de equipo duplicado",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('409', () => pm.response.to.have.status(409));"]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Barcelona\"\n}" },
            "url": "{{baseUrl}}/api/teams"
          }
        },
        {
          "name": "Partido con el mismo equipo",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('400', () => pm.response.to.have.status(400));"]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"homeTeamId\": \"{{teamId}}\",\n  \"awayTeamId\": \"{{teamId}}\",\n  \"kickoff\": \"2026-10-26T15:00:00Z\"\n}"
            },
            "url": "{{baseUrl}}/api/matches"
          }
        },
        {
          "name": "POST sin Idempotency-Key",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('400', () => pm.response.to.have.status(400));"]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Sin clave\"\n}" },
            "url": "{{baseUrl}}/api/teams"
          }
        }
      ]
    }
  ]
}
